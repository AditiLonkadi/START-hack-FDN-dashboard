# Default MVP mode: no Supabase credentials are needed.
DASHBOARD_DATA_MODE=live
# Server refresh interval, clamped to 30–60 seconds.
DASHBOARD_REFRESH_SECONDS=45

# Needed only when DASHBOARD_DATA_MODE=supabase.
# Public project URL. Safe to use in server code only in this application.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Protects POST /api/ingest for a scheduler such as Supabase Cron or GitHub Actions.
INGEST_CRON_SECRET=
